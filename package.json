{
  "name": "akasha-company-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Akasha Corporation bilingual product and research website.",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "build": "npm run build:client && npm run build:ssr && node scripts/postbuild.mjs",
    "check": "node scripts/check-built.mjs",
    "test": "npm run build && npm run check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/italiana": "^5.2.7",
    "gsap": "^3.13.0",
    "lenis": "^1.3.15",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
